#pragma once

// Copy this file to your sketch/project folder and rename it to:
//   lc29hconfig.h
//
// The project config runner in LC29H_ProjectConfig.h will detect this file.
// Examples call LC29H_bringUp() (adopt live SVIN, NMEA schedule, PAIR023 as needed).

// -----------------------------------------------------------------------------
// ROLE SELECTOR
// -----------------------------------------------------------------------------
// Pick one role. This decides which profile workflow is applied at startup.
#define LC29H_ROLE_UAS_ROVER 1
#define LC29H_ROLE_BASE_SURVEY 2
#define LC29H_ROLE_BASE_STATIC 3
#define LC29H_ROLE LC29H_ROLE_UAS_ROVER

// -----------------------------------------------------------------------------
// GENERIC OPTIONS (all roles)
// -----------------------------------------------------------------------------
// Save/verify apply to role workflows.
// SAVE=1 writes config to module flash.
// VERIFY=1 performs readback checks after applying profile commands.
#define LC29H_CFG_SAVE 1
#define LC29H_CFG_VERIFY 1

// RTCM output toggle used by base-oriented profile paths.
// Safe to keep enabled even in rover configs; it is only used where relevant.
#define LC29H_CFG_ENABLE_RTCM 1

// Bridge mode choices (used by bridge examples):
// FORWARD_ALL: pass all incoming bytes.
// RTCM_ONLY: pass RTCM frames only.
// RTCM_AND_NMEA_ALLOWLIST: pass RTCM + selected NMEA/PQTM lines.
#define LC29H_CFG_BRIDGE_MODE_FORWARD_ALL 0
#define LC29H_CFG_BRIDGE_MODE_RTCM_ONLY 1
#define LC29H_CFG_BRIDGE_MODE_RTCM_AND_NMEA_ALLOWLIST 2

// Recommended bridge default for base-to-rover correction links.
#define LC29H_CFG_BRIDGE_MODE LC29H_CFG_BRIDGE_MODE_RTCM_AND_NMEA_ALLOWLIST

// NMEA/PQTM allowlist used when BRIDGE_MODE=RTCM_AND_NMEA_ALLOWLIST.
// Set BRIDGE_NMEA_FILTER_ENABLED=0 to forward all NMEA lines.
#define LC29H_CFG_BRIDGE_NMEA_FILTER_ENABLED 1
#define LC29H_CFG_BRIDGE_FORWARD_NMEA_GGA 1
#define LC29H_CFG_BRIDGE_FORWARD_NMEA_GST 0
#define LC29H_CFG_BRIDGE_FORWARD_NMEA_RMC 0
#define LC29H_CFG_BRIDGE_FORWARD_PQTM_STATUS 0

// Bridge local debug output mode:
// NONE: suppress local mirror output.
// NMEA_ONLY: print parsed NMEA/status lines.
// RAW_BINARY: mirror all raw bytes to debug stream.
#define LC29H_CFG_LOCAL_DEBUG_OUTPUT_NONE 0
#define LC29H_CFG_LOCAL_DEBUG_OUTPUT_NMEA_ONLY 1
#define LC29H_CFG_LOCAL_DEBUG_OUTPUT_RAW_BINARY 2
#define LC29H_CFG_LOCAL_DEBUG_OUTPUT_MODE LC29H_CFG_LOCAL_DEBUG_OUTPUT_NMEA_ONLY

// Recovery policy for retries on command/query/raw writes.
// Keep low values on small boards to limit latency and stack churn.
#define LC29H_CFG_RECOVERY_COMMAND_RETRIES 1
#define LC29H_CFG_RECOVERY_QUERY_RETRIES 1
#define LC29H_CFG_RECOVERY_RAW_WRITE_RETRIES 1
#define LC29H_CFG_RECOVERY_RETRY_DELAY_MS 10
#define LC29H_CFG_RECOVERY_EMIT_EVENTS 1

// -----------------------------------------------------------------------------
// ROVER OPTIONS
// -----------------------------------------------------------------------------
// Rover profile fix/update interval in ms.
#define LC29H_CFG_FIX_RATE_MS 200

// Rover correction bridge behavior.
// PRINT_LOCAL_NMEA=1 echoes GNSS NMEA to local debug stream.
// FORWARD_NMEA_TO_LINK=1 forwards NMEA back out correction link stream.
// CORRECTION_CHUNK_SIZE tunes ingest burst size (bytes).
#define LC29H_CFG_ROVER_PRINT_LOCAL_NMEA 1
#define LC29H_CFG_ROVER_FORWARD_NMEA_TO_LINK 0
#define LC29H_CFG_ROVER_CORRECTION_CHUNK_SIZE 256

// Rover accuracy tracker.
// ENABLE=1 turns on tracking used by rover_status command.
// WINDOW_MIN is the tracking span.
// MAX_POINTS: 0=board-default, non-zero=force exact point count.
#define LC29H_CFG_ROVER_ACCURACY_TRACK_ENABLE 0
#define LC29H_CFG_ROVER_ACCURACY_TRACK_WINDOW_MIN 60
#define LC29H_CFG_ROVER_ACCURACY_TRACK_MAX_POINTS 0

// -----------------------------------------------------------------------------
// BASE STATION OPTIONS
// -----------------------------------------------------------------------------
// Survey-in base profile.
// MIN_TIME_SEC is MinDur (position-fix count at 1 Hz, so seconds at 1 Hz).
// MIN_STDDEV_M is <3D_AccLimit> in meters. Quectel default 15.0 starts <Obs>
// on LC29H(DA). 0 / 1.5 / 2 left Obs at 0. After apply: SAVEPAR then PAIR023.
#define LC29H_CFG_SURVEY_MIN_TIME_SEC 3600
#define LC29H_CFG_SURVEY_MIN_STDDEV_M 15.0f

// Base survey accuracy tracker.
// ENABLE=1 turns on tracking used by survey_status command.
// WINDOW_SEC should usually match SURVEY_MIN_TIME_SEC.
// MAX_POINTS: 0=board-default, non-zero=force exact point count.
#define LC29H_CFG_BASE_ACCURACY_TRACK_ENABLE 0
#define LC29H_CFG_BASE_ACCURACY_TRACK_WINDOW_SEC LC29H_CFG_SURVEY_MIN_TIME_SEC
#define LC29H_CFG_BASE_ACCURACY_TRACK_MAX_POINTS 0

// Post-survey auto-finalize.
// Leave 0 while survey-in is running (Valid=1). Set 1 only after Valid=2 to
// capture ECEF and rewrite it as fixed-base coordinates.
#define LC29H_CFG_FINALIZE_SURVEY_TO_FIXED 0
#define LC29H_CFG_SURVEY_CAPTURE_TIMEOUT_MS 2000

// Static base coordinates (used by BASE_STATIC role).
#define LC29H_CFG_BASE_LAT_DEG 33.259933
#define LC29H_CFG_BASE_LON_DEG -97.897003
#define LC29H_CFG_BASE_ALT_M 276.0
